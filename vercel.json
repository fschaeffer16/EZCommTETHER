{
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/demo.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/ezvoxa.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "ezvoxa.com"
        }
      ],
      "destination": "/ezvoxa.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.ezvoxa.com"
        }
      ],
      "destination": "/ezvoxa.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "myezvoice.com"
        }
      ],
      "destination": "/ezvoxa.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.myezvoice.com"
        }
      ],
      "destination": "/ezvoxa.html"
    }
  ]
}