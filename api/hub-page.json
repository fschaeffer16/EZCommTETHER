{
 "note": "The EZvoxa Executive Master Hub page Frank pasted 8 Sep 2026, written by an independent AI that researched the market after reviewing the product screenshots and demo. Served only with the family password (api/hub.js) because it carries prices. Edits, all on Frank's word: the citation stubs left by the paste were removed; on 8 Sep the Projections tab became a channel widget (All combined, Individual app sales, Family subscriptions, Schools, Clinics; each year sales, expenses, gross, net) computed by finance-model.js from the page's own ramp, with the original table kept under a toggle. Roadmap, Costs and Webhooks are untouched.",
 "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes\">\n  <title>EZvoxa Executive Master Hub</title>\n  <style>\n    :root {\n      --bg: #0b0f19;\n      --card-bg: #111827;\n      --border: #1f2937;\n      --text: #f9fafb;\n      --text-muted: #9ca3af;\n      --accent: #38bdf8;\n      --accent-green: #34d399;\n    }\n    * { box-sizing: border-box; }\n    body {\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n      background: var(--bg);\n      color: var(--text);\n      margin: 0;\n      padding: 12px;\n      line-height: 1.5;\n    }\n    .header {\n      padding: 8px 4px 14px 4px;\n      border-bottom: 1px solid var(--border);\n      margin-bottom: 16px;\n    }\n    h1 { font-size: 19px; margin: 0 0 2px 0; color: #fff; }\n    .subhead { font-size: 11.5px; color: var(--text-muted); }\n\n    /* PURE CSS TAB ENGINE (ZERO JAVASCRIPT REQUIRED FOR TABS) */\n    .css-tabs {\n      display: flex;\n      flex-direction: column;\n      width: 100%;\n    }\n    /* Hide the radio inputs */\n    .css-tabs input[type=\"radio\"] {\n      display: none;\n    }\n    /* Sticky Top Button Bar */\n    .tab-nav {\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n      gap: 6px;\n      position: sticky;\n      top: 0;\n      background: var(--bg);\n      padding: 6px 0 12px 0;\n      z-index: 999;\n      border-bottom: 1px solid var(--border);\n      margin-bottom: 16px;\n    }\n    .tab-label {\n      background: #1f2937;\n      border: 1px solid var(--border);\n      color: var(--text-muted);\n      padding: 12px 4px;\n      border-radius: 6px;\n      font-size: 11px;\n      font-weight: 700;\n      text-align: center;\n      cursor: pointer;\n      user-select: none;\n      -webkit-user-select: none;\n      white-space: nowrap;\n      overflow: hidden;\n      text-overflow: ellipsis;\n    }\n    \n    /* Highlight Active Button */\n    #tab-radio-1:checked ~ .tab-nav label[for=\"tab-radio-1\"],\n    #tab-radio-2:checked ~ .tab-nav label[for=\"tab-radio-2\"],\n    #tab-radio-3:checked ~ .tab-nav label[for=\"tab-radio-3\"],\n    #tab-radio-4:checked ~ .tab-nav label[for=\"tab-radio-4\"] {\n      background: var(--accent);\n      color: #0b0f19;\n      border-color: var(--accent);\n    }\n\n    /* Tab Panes */\n    .tab-pane {\n      display: none;\n    }\n    #tab-radio-1:checked ~ #content-1,\n    #tab-radio-2:checked ~ #content-2,\n    #tab-radio-3:checked ~ #content-3,\n    #tab-radio-4:checked ~ #content-4 {\n      display: block;\n    }\n\n    .card {\n      background: var(--card-bg);\n      border: 1px solid var(--border);\n      padding: 16px;\n      border-radius: 8px;\n      margin-bottom: 14px;\n    }\n    .card h2 { margin-top: 0; font-size: 15px; color: var(--accent); border-bottom: 1px solid var(--border); padding-bottom: 6px; }\n    .card h3 { font-size: 13px; color: #fff; margin-top: 14px; margin-bottom: 6px; }\n\n    /* Scrollable Table Wrapper */\n    .table-wrapper {\n      width: 100%;\n      overflow-x: auto;\n      -webkit-overflow-scrolling: touch;\n      border: 1px solid var(--border);\n      border-radius: 6px;\n      margin: 12px 0;\n    }\n    table { width: 100%; min-width: 650px; border-collapse: collapse; font-size: 11.5px; background: var(--card-bg); }\n    th, td { padding: 8px 10px; text-align: left; border-bottom: 1px solid var(--border); white-space: nowrap; }\n    th { background: #1f2937; color: var(--text-muted); font-weight: 600; text-transform: uppercase; font-size: 10px; }\n    td.num { text-align: right; font-variant-numeric: tabular-nums; }\n    .highlight { color: var(--accent-green); font-weight: 700; }\n\n    .code-block {\n      background: #030712;\n      color: #38bdf8;\n      padding: 12px;\n      border-radius: 6px;\n      font-family: monospace;\n      font-size: 10.5px;\n      overflow-x: auto;\n      white-space: pre;\n      border: 1px solid var(--border);\n    }\n    ul { padding-left: 20px; color: var(--text-muted); }\n    li { margin-bottom: 8px; font-size: 12px; }\n    strong { color: #fff; }\n    p { font-size: 12px; color: var(--text-muted); }\n\n    .chan-nav { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0 4px; }\n    .chan-nav button { background: #1f2937; border: 1px solid var(--border); color: var(--text-muted); padding: 10px 12px; border-radius: 6px; font-size: 12px; font-weight: 700; cursor: pointer; font-family: inherit; }\n    .chan-nav button.on { background: var(--accent-green); color: #0b0f19; border-color: var(--accent-green); }\n    td.neg { color: #fca5a5; }\n\n    /* Simple View All Alternative */\n    .jump-box {\n      background: #111827;\n      padding: 10px 14px;\n      border-radius: 6px;\n      border: 1px dashed var(--border);\n      margin-bottom: 16px;\n      font-size: 12px;\n    }\n    .jump-box a {\n      color: var(--accent);\n      text-decoration: none;\n      margin-right: 12px;\n      font-weight: 600;\n    }\n  </style>\n</head>\n<body>\n\n<div class=\"header\">\n  <h1>EZvoxa National Master Hub</h1>\n  <div class=\"subhead\">EZ Voice LLC &bull; Hardware-Free Assistive Tech &bull; 2026 Model</div>\n</div>\n\n<div class=\"css-tabs\">\n  <!-- Invisible radio inputs acting as state switches -->\n  <input type=\"radio\" name=\"master_tab\" id=\"tab-radio-1\" checked>\n  <input type=\"radio\" name=\"master_tab\" id=\"tab-radio-2\">\n  <input type=\"radio\" name=\"master_tab\" id=\"tab-radio-3\">\n  <input type=\"radio\" name=\"master_tab\" id=\"tab-radio-4\">\n\n  <!-- Real clickable HTML labels -->\n  <div class=\"tab-nav\">\n    <label class=\"tab-label\" for=\"tab-radio-1\">Projections</label>\n    <label class=\"tab-label\" for=\"tab-radio-2\">Roadmap</label>\n    <label class=\"tab-label\" for=\"tab-radio-3\">Costs &amp; Ops</label>\n    <label class=\"tab-label\" for=\"tab-radio-4\">Webhooks</label>\n  </div>\n\n  <!-- PANE 1: PROJECTIONS -->\n  <div class=\"tab-pane\" id=\"content-1\">\n    <div class=\"card\">\n      <h2>5-Year Projections by Channel (Statewide to National)</h2>\n      <p>One button per channel, and one for everything combined. Sales is what customers pay. Gross is sales minus the direct costs of those sales (the store's 15%, RevenueCat, refunds, texts, voice, alerts, acquisition). Net is gross minus overhead (Vercel, the Twilio number, Apple, Google, 10DLC, Codemagic, operating expenses). Expenses is both together. In a single channel's view, overhead is shared out by that channel's share of sales.</p>\n      <div class=\"chan-nav\" id=\"chan-nav\"></div>\n      <div class=\"table-wrapper\">\n        <table id=\"chan-table\">\n          <thead><tr><th>Year</th><th>Units</th><th class=\"num\">Sales</th><th class=\"num\">Expenses</th><th class=\"num\">Gross</th><th class=\"num\">Net</th><th class=\"num\">Running Net</th></tr></thead>\n          <tbody></tbody>\n        </table>\n      </div>\n      <p id=\"chan-note\"></p>\n      <h3 style=\"cursor:pointer\" id=\"orig-toggle\">Show the original table &#9662;</h3>\n      <div id=\"orig-table\" style=\"display:none\">\n      <p>Reflects the $99.99 core app ($84.99 net), $9.99/mo subscription ($8.49 net), and $249.99 school license ($106.25 net) with adult stroke/aphasia adoption and district scaling.</p>\n<div class=\"table-wrapper\">\n        <table>\n          <thead>\n            <tr>\n              <th>Year</th>\n              <th class=\"num\">App Buyers</th>\n              <th class=\"num\">Active Subs</th>\n              <th>Institutional Scope</th>\n              <th class=\"num\">App Net</th>\n              <th class=\"num\">Tether Net</th>\n              <th class=\"num\">School Net</th>\n              <th class=\"num\">OpEx &amp; RC</th>\n              <th class=\"num\">Annual Net</th>\n              <th class=\"num\">Cumulative</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <td>Year 1</td>\n              <td class=\"num\">2,400</td>\n              <td class=\"num\">450</td>\n              <td>Evan's School Pilot (Free)</td>\n              <td class=\"num\">$203,980</td>\n              <td class=\"num\">$45,854</td>\n              <td class=\"num\">$0</td>\n              <td class=\"num\">($37,439)</td>\n              <td class=\"num highlight\">$212,394</td>\n              <td class=\"num\"><strong>$212,394</strong></td>\n            </tr>\n            <tr>\n              <td>Year 2</td>\n              <td class=\"num\">5,500</td>\n              <td class=\"num\">1,450</td>\n              <td>12 FL dist (480) + 15 clinics (150)</td>\n              <td class=\"num\">$467,453</td>\n              <td class=\"num\">$147,752</td>\n              <td class=\"num\">$66,935</td>\n              <td class=\"num\">($60,938)</td>\n              <td class=\"num highlight\">$621,202</td>\n              <td class=\"num\"><strong>$833,597</strong></td>\n            </tr>\n            <tr>\n              <td>Year 3</td>\n              <td class=\"num\">8,500</td>\n              <td class=\"num\">2,900</td>\n              <td>45 FL/SE dist (2k) + 50 clinics (500)</td>\n              <td class=\"num\">$722,428</td>\n              <td class=\"num\">$295,504</td>\n              <td class=\"num\">$265,614</td>\n              <td class=\"num\">($93,676)</td>\n              <td class=\"num highlight\">$1,189,871</td>\n              <td class=\"num\"><strong>$2,023,468</strong></td>\n            </tr>\n            <tr>\n              <td>Year 4</td>\n              <td class=\"num\">11,500</td>\n              <td class=\"num\">4,600</td>\n              <td>140 multi-state (7k) + 120 clinics (1.2k)</td>\n              <td class=\"num\">$977,402</td>\n              <td class=\"num\">$468,731</td>\n              <td class=\"num\">$871,215</td>\n              <td class=\"num\">($131,713)</td>\n              <td class=\"num highlight\">$2,185,635</td>\n              <td class=\"num\"><strong>$4,209,102</strong></td>\n            </tr>\n            <tr>\n              <td>Year 5</td>\n              <td class=\"num\">14,500</td>\n              <td class=\"num\">6,500</td>\n              <td>320 national (17.5k) + 250 clinics (2.5k)</td>\n              <td class=\"num\">$1,232,377</td>\n              <td class=\"num\">$662,337</td>\n              <td class=\"num\">$2,124,915</td>\n              <td class=\"num\">($169,991)</td>\n              <td class=\"num highlight\">$3,849,638</td>\n              <td class=\"num\"><strong>$8,058,740</strong></td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- PANE 2: ROADMAP -->\n  <div class=\"tab-pane\" id=\"content-2\">\n    <div class=\"card\">\n      <h2>Statewide to National Rollout Strategy</h2>\n      <h3>Phase 1: Regional Florida Cluster (Months 6–18)</h3>\n      <ul>\n        <li><strong>Anchor Pilot:</strong> Evan's school in St. Lucie County with documented classroom data from Cynthia Puentes.</li>\n        <li><strong>FDLRS Centers:</strong> Provide demonstration units to Florida Diagnostic &amp; Learning Resources System centers serving Martin, Palm Beach, Brevard, Indian River, and Okeechobee counties.</li>\n      </ul>\n\n      <h3>Phase 2: Statewide Florida &amp; Regional Hubs (Months 18–36)</h3>\n      <ul>\n        <li><strong>State AT Loan Programs:</strong> Place units in FAAST (Florida Alliance for Assistive Services and Technology) lending libraries so school SLPs can evaluate IEP fit before ordering.</li>\n        <li><strong>Micro-Purchasing:</strong> Keep orders under the $10,000 threshold so ESE Directors can sign off directly using IDEA Part B funds without board votes.</li>\n      </ul>\n\n      <h3>Phase 3: National Rollout (Months 36–60)</h3>\n      <ul>\n        <li><strong>Industry Conferences:</strong> Exhibit live student presentation outcomes at ATIA in Orlando and CEC national conventions.</li>\n        <li><strong>Apple School Manager:</strong> Nationwide districts order perpetual volume licenses via established district Apple accounts with zero vendor RFP friction.</li>\n      </ul>\n    </div>\n  </div>\n\n  <!-- PANE 3: COSTS -->\n  <div class=\"tab-pane\" id=\"content-3\">\n    <div class=\"card\">\n      <h2>Operational Cost Schedule</h2>\n      <div class=\"table-wrapper\">\n        <table>\n          <thead>\n            <tr>\n              <th>Service</th>\n              <th>Type</th>\n              <th>Rate / Cost</th>\n              <th>Operational Purpose</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr><td>Apple Developer</td><td>Annual</td><td>$99.00 / yr</td><td>StoreKit distribution &amp; verification.</td></tr>\n            <tr><td>Google Play</td><td>One-time</td><td>$25.00 one-time</td><td>Android console verification.</td></tr>\n            <tr><td>RevenueCat</td><td>Usage</td><td>1% over $2,500/mo gross</td><td>Cross-platform receipt validation.</td></tr>\n            <tr><td>Twilio 10DLC</td><td>Compliance</td><td>$19 one-time</td><td>Mandatory FCC registration for outbound SMS.</td></tr>\n            <tr><td>Twilio Telecom</td><td>Usage</td><td>~$0.0135 / SMS</td><td>Cellular GPS emergency alert texts.</td></tr>\n            <tr><td>ElevenLabs</td><td>API</td><td>$5 to $22 / mo base</td><td>Natural synthetic voice cached 1x per phrase.</td></tr>\n            <tr><td>Vercel Pro</td><td>Backend</td><td>$20 / month</td><td>Webhook routing &amp; Family Code database.</td></tr>\n            <tr><td>Codemagic</td><td>Pipeline</td><td>$0 (500 free min)</td><td>Native build compilation &amp; signing.</td></tr>\n          </tbody>\n        </table>\n      </div>\n    </div>\n  </div>\n\n  <!-- PANE 4: WEBHOOKS -->\n  <div class=\"tab-pane\" id=\"content-4\">\n    <div class=\"card\">\n      <h2>RevenueCat Webhook Handler (`/api/plan.js`)</h2>\n      <div class=\"code-block\">// Endpoint: https://app.ezvoxa.com/api/plan\nconst event = req.body.event;\n\nswitch (event.type) {\n  case \"NON_RENEWING_PURCHASE\":\n    // $99.99 Core Talker (Perpetual app ownership)\n    await grantLifetimeCoreTalker(event.app_user_id);\n    break;\n\n  case \"INITIAL_PURCHASE\":\n  case \"RENEWAL\":\n  case \"UNCANCELLATION\":\n    // $9.99/mo Connected Family Tether\n    await setFamilyPlanActive(event.app_user_id, event.expiration_at_ms);\n    break;\n\n  case \"CANCELLATION\":\n    if (event.cancel_reason === \"CUSTOMER_SUPPORT\") {\n      // Official refund: revoke entitlements & log\n      await logRefund(event.app_user_id, event.price_in_purchased_currency);\n      await revokeFamilyTether(event.app_user_id);\n    } else {\n      await flagSubscriptionPendingCancellation(event.app_user_id);\n    }\n    break;\n\n  case \"EXPIRATION\":\n    // Locks remote sync & SOS texting, keeps local speech active\n    await revokeFamilyTether(event.app_user_id);\n    break;\n}</div>\n    </div>\n  </div>\n</div>\n\n<!--EZ_INPUTS-->\n<script src=\"/finance-model.js\"></script>\n<script>\n(function () {\n  var inputs = window.EZ_INPUTS; if (!inputs || !window.EZFinance) return;\n  var R = EZFinance.project(inputs, inputs.scenarios.national);\n  var views = [\n    ['all', 'All combined'], ['talker', 'Individual app sales'], ['tether', 'Family subscriptions'], ['schools', 'Schools'], ['clinics', 'Clinics']\n  ];\n  var unitWord = { talker: 'buyers', tether: 'subscribers (average)', schools: 'seats', clinics: 'seats' };\n  var view = 'all';\n  function esc(x) { var s = document.createElement('span'); s.textContent = String(x == null ? '' : x); return s.innerHTML; }\n  function money(n) { return (n < 0 ? '(' : '') + '$' + Math.abs(Math.round(n)).toLocaleString('en-US') + (n < 0 ? ')' : ''); }\n  function num(n) { return Math.round(n).toLocaleString('en-US'); }\n  function cell(v) { return '<td class=\"num' + (v.charAt(0) === '(' ? ' neg' : '') + '\">' + esc(v) + '</td>'; }\n  function render() {\n    var nav = document.getElementById('chan-nav'); nav.innerHTML = '';\n    views.forEach(function (v) {\n      var b = document.createElement('button'); b.type = 'button'; b.className = v[0] === view ? 'on' : ''; b.textContent = v[1];\n      b.onclick = function () { view = v[0]; render(); }; nav.appendChild(b);\n    });\n    var run = 0, tot = { sales: 0, expenses: 0, gross: 0, net: 0 };\n    var body = R.rows.map(function (r) {\n      var x, units;\n      if (view === 'all') {\n        x = { sales: r.gross, expenses: r.direct + r.overhead, gross: r.gross - r.direct, net: r.net };\n        units = num(r.buyers) + ' buyers, ' + num(r.subsAvg) + ' subs, ' + num(r.seats) + ' seats';\n      } else {\n        x = r.channels[view]; units = num(x.units) + ' ' + unitWord[view];\n      }\n      run += x.net; tot.sales += x.sales; tot.expenses += x.expenses; tot.gross += x.gross; tot.net += x.net;\n      return '<tr><td>Year ' + r.year + '</td><td>' + esc(units) + '</td>' + cell(money(x.sales)) + cell(money(-x.expenses)) + cell(money(x.gross)) + '<td class=\"num highlight\">' + esc(money(x.net)) + '</td><td class=\"num\"><strong>' + esc(money(run)) + '</strong></td></tr>';\n    }).join('');\n    body += '<tr><td><strong>5 years</strong></td><td></td>' + cell(money(tot.sales)) + cell(money(-tot.expenses)) + cell(money(tot.gross)) + '<td class=\"num highlight\">' + esc(money(tot.net)) + '</td><td class=\"num\"><strong>' + esc(money(run)) + '</strong></td></tr>';\n    document.querySelector('#chan-table tbody').innerHTML = body;\n    var notes = {\n      all: 'Every channel together. Units: one-time buyers, average subscribers in the year, and institutional seats (districts plus clinics).',\n      talker: 'One-time app buyers. Direct costs: the store\\'s 15%, RevenueCat\\'s share, refunds, their SOS alerts, and acquisition per buyer.',\n      tether: 'Family subscriptions, counted as the average of the year\\'s starting and ending subscribers. Direct costs: the store\\'s 15%, RevenueCat\\'s share, refunds, texts, the natural voice, and their SOS alerts.',\n      schools: 'District seats at the volume price when 20 or more institutional seats are sold in the year. Direct cost: the store\\'s 15%, because the seats go through Apple School Manager and Google Play.',\n      clinics: 'Therapists\\' seats, priced at the school rate. Direct cost: the store\\'s 15%.'\n    };\n    document.getElementById('chan-note').textContent = notes[view] + ' Prices and costs are the working numbers in the finance defaults as of ' + inputs.asOf + '; nothing is confirmed until Frank confirms it.';\n  }\n  render();\n  var t = document.getElementById('orig-toggle'), o = document.getElementById('orig-table');\n  t.onclick = function () { var show = o.style.display === 'none'; o.style.display = show ? 'block' : 'none'; t.innerHTML = (show ? 'Hide the original table &#9652;' : 'Show the original table &#9662;'); };\n})();\n</script>\n</body>\n</html>"
}